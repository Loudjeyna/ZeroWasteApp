<?xml version="1.0" encoding="utf-8"?>
<!--
    ZeroWaste — AndroidManifest.xml
    - يدعم RTL كامل
    - يدعم Material You (dynamicColor على Android 12+)
    - إذن التنبيهات (Android 13+)
    - إذن POST_NOTIFICATIONS للتنبيهات المنبثقة
    - إذن SCHEDULE_EXACT_ALARM للتنبيهات الدقيقة
    - receivers و services للتنبيهات في الخلفية
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- إذن التحكم بالاهتزاز عند التنبيهات -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- إذن استقبال التنبيهات (Android 13+ = API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- إذن ضبط تنبيهات دقيقة (للتنبيه عند وقت محدد) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- إذن استخدام UseExactAlarm (Android 14+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- إذن إعادة جدولة التنبيهات بعد إقلاع الجهاز -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- إذن للحفاظ على الجهاز مستيقظاً عند عرض تنبيه حرج -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".ZeroWasteApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ZeroWaste"
        tools:targetApi="35">

        <!-- الصفحة الرئيسية -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection"
            android:theme="@style/Theme.ZeroWaste.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receiver لإعادة جدولة التنبيهات بعد إعادة تشغيل الجهاز -->
        <receiver
            android:name=".ui.notifications.BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Receiver لاستقبال التنبيهات الدقيقة (AlarmManager) -->
        <receiver
            android:name=".ui.notifications.ExpiryAlarmReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- WorkManager (يُهيّأ تلقائياً، يظهر هنا فقط للتوضيح) -->
    </application>

</manifest>
