    <!-- ═════════════ 10 Algerian Recipes 🇩🇿 ═════════════ -->

    <!-- 1) Chakhchoukha -->
    <string name="recipe_chakhchoukha">Algerian Chakhchoukha</string>
    <string name="recipe_chakhchoukha_desc">Festive Algerian dish with bread, meat and broth</string>
    <string name="recipe_chakhchoukha_step_1">Prepare and bake the dough then tear into pieces</string>
    <string name="recipe_chakhchoukha_step_2">Cook meat with chickpeas, tomato and onion</string>
    <string name="recipe_chakhchoukha_step_3">Add spices and let broth thicken</string>
    <string name="recipe_chakhchoukha_step_4">Place bread in dish and pour broth with meat over it</string>

    <!-- 2) Algerian Tajine -->
    <string name="recipe_tajine_algerian">Algerian Chicken Tajine</string>
    <string name="recipe_tajine_algerian_desc">Chicken, potatoes, eggs and olives</string>
    <string name="recipe_tajine_algerian_step_1">Fry chicken with onion and tomato</string>
    <string name="recipe_tajine_algerian_step_2">Add potatoes and spices, cook until tender</string>
    <string name="recipe_tajine_algerian_step_3">Add eggs and olives, bake in oven</string>

    <!-- 3) Harira -->
    <string name="recipe_harira">Algerian Harira</string>
    <string name="recipe_harira_desc">Thick Algerian soup with lentils, chickpeas and meat</string>
    <string name="recipe_harira_step_1">Soak chickpeas and lentils overnight</string>
    <string name="recipe_harira_step_2">Cook meat with tomato and onion</string>
    <string name="recipe_harira_step_3">Add chickpeas, lentils and couscous, let cook</string>

    <!-- 4) Bourek -->
    <string name="recipe_bourek">Bourek with meat</string>
    <string name="recipe_bourek_desc">Crispy rolls stuffed with minced meat and egg</string>
    <string name="recipe_bourek_step_1">Cook minced meat with onion and egg</string>
    <string name="recipe_bourek_step_2">Roll dough and cut into rectangles</string>
    <string name="recipe_bourek_step_3">Stuff, roll and fry in hot oil</string>

    <!-- 5) Chtitha -->
    <string name="recipe_cthitha">Chtitha with chickpeas</string>
    <string name="recipe_cthitha_desc">Chicken in spicy red sauce with chickpeas and garlic</string>
    <string name="recipe_cthitha_step_1">Fry chicken with garlic, tomato and spices</string>
    <string name="recipe_cthitha_step_2">Add boiled chickpeas and let cook</string>
    <string name="recipe_cthitha_step_3">Serve hot with Algerian bread</string>

    <!-- 6) Mtewem -->
    <string name="recipe_mtewem">Mtewem</string>
    <string name="recipe_mtewem_desc">Meatballs in garlic-lemon-almond sauce</string>
    <string name="recipe_mtewem_step_1">Shape meatballs from minced meat</string>
    <string name="recipe_mtewem_step_2">Fry then add chickpeas, garlic and lemon</string>
    <string name="recipe_mtewem_step_3">Garnish with toasted almonds and serve</string>

    <!-- 7) Frik Soup -->
    <string name="recipe_frik_soup">Frik Soup</string>
    <string name="recipe_frik_soup_desc">Algerian soup with frik, meat and chickpeas</string>
    <string name="recipe_frik_soup_step_1">Boil meat with onion and tomato</string>
    <string name="recipe_frik_soup_step_2">Add chickpeas and frik</string>
    <string name="recipe_frik_soup_step_3">Let simmer on low heat for 30 minutes</string>

    <!-- 8) Algerian Couscous -->
    <string name="recipe_couscous_algerian">Algerian Couscous</string>
    <string name="recipe_couscous_algerian_desc">Algerian national dish with meat and vegetables</string>
    <string name="recipe_couscous_algerian_step_1">Steam the couscous</string>
    <string name="recipe_couscous_algerian_step_2">Prepare meat broth with vegetables and chickpeas</string>
    <string name="recipe_couscous_algerian_step_3">Serve couscous with broth, meat and vegetables</string>

    <!-- 9) Barbouche -->
    <string name="recipe_barbouche">Barbouche (Semolina dessert)</string>
    <string name="recipe_barbouche_desc">Algerian dessert with semolina and honey</string>
    <string name="recipe_barbouche_step_1">Mix semolina with butter or oil</string>
    <string name="recipe_barbouche_step_2">Bake until golden</string>
    <string name="recipe_barbouche_step_3">Pour hot honey or sugar syrup over it</string>

    <!-- 10) Zlabia -->
    <string name="recipe_zlabia">Zlabia</string>
    <string name="recipe_zlabia_desc">Crispy Algerian dessert with honey</string>
    <string name="recipe_zlabia_step_1">Prepare liquid dough and let it ferment</string>
    <string name="recipe_zlabia_step_2">Pour into hot oil in circular shape</string>
    <string name="recipe_zlabia_step_3">Pour sugar syrup or honey over it</string>

